{
  "name": "safetoship",
  "version": "0.2.0",
  "description": "Vibe code with peace of mind: a local launch hardening agent for exposed keys, Supabase gaps, cost abuse, and launch compliance.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lehamidmb/safetoship.git"
  },
  "bugs": {
    "url": "https://github.com/lehamidmb/safetoship/issues"
  },
  "homepage": "https://github.com/lehamidmb/safetoship#readme",
  "bin": {
    "safetoship": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "action.yml",
    "docs/schema",
    "rules/semgrep"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "demo": "npm run build --silent && node dist/cli.js audit fixtures/insecure-next-supabase --no-engines --fail-on never",
    "check": "npm run build && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "security",
    "supabase",
    "nextjs",
    "vibe-coding",
    "ai-generated-code",
    "launch-gate",
    "compliance",
    "privacy-policy",
    "cost-abuse",
    "cli",
    "github-action"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^14.0.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=20"
  }
}
