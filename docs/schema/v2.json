{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lehamidmb/safetoship/blob/main/docs/schema/v2.json",
  "title": "SafeToShip audit output v2",
  "type": "object",
  "required": ["schemaVersion", "tool", "target", "mode", "verdict", "counts", "findings", "acceptedRisks", "engines", "coverage", "warnings", "limits", "delta"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "safetoship" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["path", "scannedAt"],
      "properties": {
        "path": { "type": "string" },
        "scannedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "mode": { "enum": ["audit", "quick"] },
    "verdict": { "enum": ["SHIP", "SHIP-WITH-WARNINGS", "DO-NOT-SHIP"] },
    "counts": { "$ref": "#/$defs/counts" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "acceptedRisks": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "engines": { "type": "array", "items": { "$ref": "#/$defs/engine" } },
    "coverage": { "$ref": "#/$defs/coverage" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "limits": { "type": "array", "items": { "type": "string" } },
    "delta": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/delta" }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "counts": {
      "type": "object",
      "required": ["blocker", "high", "medium", "low", "total", "suppressed", "needsReview"],
      "properties": {
        "blocker": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "suppressed": { "type": "integer", "minimum": 0 },
        "needsReview": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "fingerprint", "title", "severity", "confidence", "confidenceRationale", "needsReview", "file", "line", "provenance", "why", "fixPrompt", "suppressionReason"],
      "properties": {
        "id": { "type": "string", "pattern": "^STS-" },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "title": { "type": "string" },
        "severity": { "enum": ["low", "medium", "high", "blocker"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "confidenceRationale": { "type": "string" },
        "needsReview": { "type": "boolean" },
        "file": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"] },
        "provenance": { "enum": ["source", "engine"] },
        "why": { "type": "string" },
        "fixPrompt": { "type": "string" },
        "suppressionReason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": ["id", "fingerprint", "title", "severity", "file", "line"],
      "properties": {
        "id": { "type": "string", "pattern": "^STS-" },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "title": { "type": "string" },
        "severity": { "enum": ["low", "medium", "high", "blocker"] },
        "file": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "required": ["name", "status", "message"],
      "properties": {
        "name": { "enum": ["gitleaks", "semgrep", "osv-scanner"] },
        "status": { "enum": ["ran", "skipped", "error"] },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["scannedFiles", "evaluatedRules", "excludedPaths", "build", "externalEngines"],
      "properties": {
        "scannedFiles": { "type": "integer", "minimum": 0 },
        "evaluatedRules": { "type": "array", "items": { "type": "string", "pattern": "^STS-" }, "uniqueItems": true },
        "excludedPaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "build": {
          "type": "object",
          "required": ["requested", "status", "command", "scannedFiles", "outputPaths", "skippedLargeFiles"],
          "properties": {
            "requested": { "type": "boolean" },
            "status": { "enum": ["not-requested", "completed", "no-supported-output"] },
            "command": { "type": ["string", "null"] },
            "scannedFiles": { "type": "integer", "minimum": 0 },
            "outputPaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "skippedLargeFiles": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "externalEngines": {
          "type": "object",
          "required": ["requested", "statuses"],
          "properties": {
            "requested": { "type": "boolean" },
            "statuses": { "type": "array", "items": { "$ref": "#/$defs/engine" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "delta": {
      "type": "object",
      "required": ["baseline", "counts", "newFindings", "resolvedFindings", "unchangedFingerprints"],
      "properties": {
        "baseline": {
          "type": "object",
          "required": ["schemaVersion", "source"],
          "properties": {
            "schemaVersion": { "enum": [1, 2] },
            "source": { "type": "string" }
          },
          "additionalProperties": false
        },
        "counts": {
          "type": "object",
          "required": ["new", "resolved", "unchanged"],
          "properties": {
            "new": { "type": "integer", "minimum": 0 },
            "resolved": { "type": "integer", "minimum": 0 },
            "unchanged": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "newFindings": { "type": "array", "items": { "$ref": "#/$defs/snapshot" } },
        "resolvedFindings": { "type": "array", "items": { "$ref": "#/$defs/snapshot" } },
        "unchangedFingerprints": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{16}$" }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  }
}
