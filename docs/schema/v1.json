{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lehamidmb/safetoship/blob/main/docs/schema/v1.json",
  "title": "SafeToShip audit output v1",
  "type": "object",
  "required": ["schemaVersion", "tool", "target", "mode", "verdict", "counts", "findings", "acceptedRisks", "engines", "warnings", "limits", "delta"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "safetoship" },
        "version": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "required": ["path", "scannedAt"],
      "properties": {
        "path": { "type": "string" },
        "scannedAt": { "type": "string", "format": "date-time" }
      }
    },
    "mode": { "enum": ["audit", "quick"] },
    "verdict": { "enum": ["SHIP", "SHIP-WITH-WARNINGS", "DO-NOT-SHIP"] },
    "counts": {
      "type": "object",
      "required": ["blocker", "high", "medium", "low", "total", "suppressed", "needsReview"],
      "properties": {
        "blocker": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "suppressed": { "type": "integer", "minimum": 0 },
        "needsReview": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "acceptedRisks": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "engines": { "type": "array" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "limits": { "type": "array", "items": { "type": "string" } },
    "delta": { "type": ["object", "null"] }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "fingerprint", "title", "severity", "confidence", "confidenceRationale", "needsReview", "file", "line", "provenance", "why", "fixPrompt", "suppressionReason"],
      "properties": {
        "id": { "type": "string", "pattern": "^STS-" },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "title": { "type": "string" },
        "severity": { "enum": ["low", "medium", "high", "blocker"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "confidenceRationale": { "type": "string" },
        "needsReview": { "type": "boolean" },
        "file": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"] },
        "provenance": { "enum": ["source", "engine"] },
        "why": { "type": "string" },
        "fixPrompt": { "type": "string" },
        "suppressionReason": { "type": ["string", "null"] }
      }
    }
  }
}
